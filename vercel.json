{
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/public",
  "framework": "vite",
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    { "src": "^/api/ask-lizheng/ops/(session|summary|records|export|delete|discovery-list|discovery-save|discovery-publish|discovery-withdraw)$", "dest": "/api/ask-lizheng-ops?__route=$1" },
    { "src": "^/api/ask-lizheng/discovery/(lists|questions|detail|vote)$", "has": [{ "type": "host", "value": "(?:www|ask)\\.lizheng\\.ai" }], "dest": "/api/ask-lizheng-discovery?__route=$1" },
    { "src": "^/ask$", "has": [{ "type": "host", "value": "www\\.lizheng\\.ai" }], "dest": "/api/ask-lizheng-public?__route=index" },
    { "src": "^/ask/sitemap\\.xml$", "has": [{ "type": "host", "value": "www\\.lizheng\\.ai" }], "dest": "/api/ask-lizheng-public?__route=sitemap" },
    { "src": "^/ask/([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$", "has": [{ "type": "host", "value": "www\\.lizheng\\.ai" }], "dest": "/api/ask-lizheng-public?__route=page&id=$1" },
    {
      "src": "^/ops/ask-lizheng$",
      "has": [{ "type": "host", "value": "www\\.lizheng\\.ai" }],
      "dest": "/api/ask-lizheng-ops-page",
      "headers": { "Cache-Control": "no-store", "X-Robots-Tag": "noindex, nofollow, noarchive", "Referrer-Policy": "no-referrer", "X-Frame-Options": "DENY" }
    },
    {
      "src": "^/ops/ask-lizheng/assets/([A-Za-z0-9_-]+-[A-Za-z0-9_-]{6,32}\\.(?:js|css))$",
      "has": [{ "type": "host", "value": "www\\.lizheng\\.ai" }],
      "dest": "/api/ask-lizheng-ops-page?__asset=$1",
      "headers": { "Cache-Control": "no-store", "X-Robots-Tag": "noindex, nofollow, noarchive", "Referrer-Policy": "no-referrer", "X-Frame-Options": "DENY" }
    },
    { "src": "^/api/ask-lizheng/usage$", "has": [{ "type": "host", "value": "(?:www|ask)\\.lizheng\\.ai" }], "dest": "/api/ask-lizheng-usage" },
    { "src": "^/api/ask-lizheng/(share)$", "has": [{ "type": "host", "value": "(?:www|ask)\\.lizheng\\.ai" }], "dest": "/api/ask-lizheng-share?__route=$1" },
    { "src": "^/s/(\\d{4}-\\d{2}-\\d{2})/([a-z0-9]+(?:-[a-z0-9]+){0,4})$", "has": [{ "type": "host", "value": "ask\\.lizheng\\.ai" }], "dest": "/api/ask-lizheng-share?__route=page&day=$1&slug=$2" },
    { "src": "^/s/sitemap\\.xml$", "has": [{ "type": "host", "value": "ask\\.lizheng\\.ai" }], "dest": "/api/ask-lizheng-share?__route=sitemap" },
    { "src": "^/s/(page\\.js|fonts\\.css)$", "has": [{ "type": "host", "value": "ask\\.lizheng\\.ai" }], "dest": "/s/$1", "headers": { "Cache-Control": "public, max-age=3600" } },
    { "src": "^/s(?:/.*)?$", "has": [{ "type": "host", "value": "ask\\.lizheng\\.ai" }], "dest": "/api/ask-lizheng-share?__route=page" },
    { "src": "^/s/(.+)$", "has": [{ "type": "host", "value": "www\\.lizheng\\.ai" }], "status": 308, "headers": { "Location": "https://ask.lizheng.ai/s/$1" } },
    { "src": "/api/ask-lizheng/query-storage", "dest": "/api/ask-lizheng-query" },
    { "src": "/api/ask-lizheng/quota-storage", "dest": "/api/ask-lizheng-quota" },
    { "src": "/api/ask-lizheng/auth/(login|callback|session|logout|email-request|email-verify)", "dest": "/api/ask-lizheng-auth?__route=$1" },
    {
      "src": "/api/ask",
      "has": [{ "type": "host", "value": "ask\\.lizheng\\.ai" }],
      "dest": "/api/ask-lizheng"
    },
    { "src": "/api/ask-lizheng/ask", "dest": "/api/ask-lizheng" },
    { "src": "^/ask-app/assets/(noto-serif-sc-[A-Za-z0-9_-]+\\.woff2)$", "dest": "/assets/$1", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "src": "^/ask-app/assets/([A-Za-z0-9_.-]+)$", "dest": "/ask-app/assets/$1", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "src": "^/ask-app/?$", "has": [{ "type": "host", "value": "www\\.lizheng\\.ai" }], "status": 308, "headers": { "Location": "https://ask.lizheng.ai/" } },
    {
      "src": "/assets/(.*)",
      "has": [{ "type": "host", "value": "ask\\.lizheng\\.ai" }],
      "dest": "https://ask-lizheng.ai-builders.space/assets/$1",
      "respectOriginCacheControl": true
    },
    { "src": "^/$", "has": [{ "type": "host", "value": "ask\\.lizheng\\.ai" }], "dest": "/ask-app" },
    { "src": "^/robots\\.txt$", "has": [{ "type": "host", "value": "ask\\.lizheng\\.ai" }], "dest": "/ask-app/robots.txt" },
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "ask\\.lizheng\\.ai" }],
      "dest": "https://ask-lizheng.ai-builders.space/$1",
      "respectOriginCacheControl": false,
      "headers": { "Cache-Control": "no-store" }
    },
    {
      "src": "/api/ask-lizheng/meta",
      "dest": "https://ask-lizheng.ai-builders.space/api/meta",
      "respectOriginCacheControl": false,
      "headers": { "Cache-Control": "no-store" }
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/decks/fake-work-fake-learning",
      "dest": "https://columbia-fake-work-learning.vercel.app/"
    },
    {
      "src": "/decks/fake-work-fake-learning/(.+)",
      "dest": "https://columbia-fake-work-learning.vercel.app/$1"
    },
    {
      "src": "/decks/superlinear-one-year",
      "dest": "https://superlinear-one-year-2026.vercel.app/decks/superlinear-one-year/"
    },
    {
      "src": "/decks/superlinear-one-year/(.+)",
      "dest": "https://superlinear-one-year-2026.vercel.app/decks/superlinear-one-year/$1"
    },
    {
      "src": "/decks/fake-work",
      "dest": "https://fake-work-2026.vercel.app/decks/fake-work/"
    },
    {
      "src": "/decks/fake-work/(.+)",
      "dest": "https://fake-work-2026.vercel.app/decks/fake-work/$1"
    },
    {
      "src": "/decks/ai-side-income-career-capital",
      "dest": "https://ai-side-income-2026.vercel.app/decks/ai-side-income-career-capital"
    },
    {
      "src": "/decks/ai-side-income-career-capital/(.+)",
      "dest": "https://ai-side-income-2026.vercel.app/decks/ai-side-income-career-capital/$1"
    },
    {
      "src": "/decks/ai-side-income-commercial-gates",
      "dest": "https://ai-side-income-2026.vercel.app/decks/ai-side-income-commercial-gates"
    },
    {
      "src": "/decks/ai-side-income-commercial-gates/(.+)",
      "dest": "https://ai-side-income-2026.vercel.app/decks/ai-side-income-commercial-gates/$1"
    },
    {
      "src": "/zh",
      "status": 308,
      "headers": { "Location": "/" }
    },
    {
      "src": "/zh/(.*)",
      "status": 308,
      "headers": { "Location": "/$1" }
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "speaker\\.lizheng\\.ai"
        }
      ],
      "dest": "/speaker"
    },
    {
      "src": "/guest",
      "has": [
        {
          "type": "host",
          "value": "podcast\\.lizheng\\.ai"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://speaker.lizheng.ai/"
      }
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "creators\\.lizheng\\.ai"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://www.lizheng.ai/collab/creators"
      }
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "podcast\\.lizheng\\.ai"
        }
      ],
      "dest": "/podcast"
    },
    {
      "src": "/collab/podcast-one-pager\\.pdf",
      "status": 308,
      "headers": { "Location": "/collab/podcast-kit-zh.pdf" }
    },
    {
      "src": "/podcast-feed\\.xml",
      "dest": "https://feeds.transistor.fm/kedaibiao",
      "headers": {
        "x-vercel-enable-rewrite-caching": "1",
        "CDN-Cache-Control": "public, s-maxage=300, stale-while-revalidate=86400"
      }
    },
    { "handle": "filesystem" }
  ]
}
