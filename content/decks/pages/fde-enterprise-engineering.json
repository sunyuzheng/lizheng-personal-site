     "fs": 15,
     "fw": 400,
     "li": false,
     "box": [
      1072,
      497,
      429,
      47
     ]
    },
    {
     "text": "我的体感是：这个团队对拿下很多大客户、让客户真正用起来，非常关键。",
     "tag": "p",
     "fs": 17,
     "fw": 400,
     "li": false,
     "box": [
      101,
      787,
      1401,
      29
     ]
    }
