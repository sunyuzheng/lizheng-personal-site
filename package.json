{
  "name": "lizheng-personal-site",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist && tsx scripts/prerender-guests.ts && tsx scripts/prerender-book.ts && tsx scripts/prerender-writing.ts",
    "start": "NODE_ENV=production node dist/index.js",
    "preview": "vite preview --host",
    "check": "tsc --noEmit",
    "verify:domain": "tsx scripts/verify-domain.ts",
    "sync:guest-video-metadata": "tsx scripts/sync-guest-video-metadata.ts",
    "refresh:guests": "pnpm sync:guest-video-metadata && pnpm check && pnpm build",
    "format": "prettier --write .",
    "sync:guest-insights": "tsx scripts/sync-guest-insights.ts",
    "community:city": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/build-community-city.ts",
    "test:ask-lizheng": "vitest run --config vitest.ask-lizheng.config.ts",
    "sync:ask-app": "node scripts/sync-ask-app.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "@fontsource/noto-serif-sc": "5.3.0",
    "@logto/node": "3.1.10",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@vercel/analytics": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^4.22.3",
    "lucide-react": "^0.453.0",
    "next-themes": "^0.4.6",
    "qrcode-generator": "2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "10.1.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "wouter": "^3.7.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/express": "4.17.21",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vercel/blob": "^2.8.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.25.10",
    "pnpm": "^10.34.6",
    "postcss": "^8.5.28",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.6.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "packageManager": "pnpm@10.34.6+sha512.7e1ae66a83a9143c118cc1944f37cc4f2b8acddeda4b001cfa78908f6e46e45e15292739ca6c9d026426cc757e9318cc98c5551d6a16c165097b0028ba87b4e6",
  "pnpm": {
    "patchedDependencies": {
      "wouter@3.7.1": "patches/wouter@3.7.1.patch"
    },
    "overrides": {
      "tailwindcss>nanoid": "3.3.7"
    }
  }
}
