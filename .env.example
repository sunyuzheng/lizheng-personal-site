# Community map (docs/community-city.md)
# Circle Admin API v2 token, only for scripts/build-community-city.ts; never exposed to the client.
CIRCLE_ADMIN_API=
# Vercel Blob store lizheng-community, for `pnpm community:city --upload` (`vercel link` writes it to .env.local).
BLOB_READ_WRITE_TOKEN=

# Guest intake uses the site's existing private ASK_AUTH_REDIS_* store and verified session.
# Independent admin allowlist and durable-record encryption key (server-only).
GUEST_INTAKE_ADMIN_EMAILS=
GUEST_INTAKE_ENCRYPTION_KEY=
