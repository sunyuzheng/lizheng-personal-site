{
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/public",
  "framework": "vite",
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "podcast\\.lizheng\\.ai"
        }
      ],
      "dest": "/podcast"
    },
    {
      "src": "/",
      "has": [{ "type": "query", "key": "lang", "value": "zh" }],
      "status": 308,
      "headers": { "Location": "/zh" }
    },
    {
      "src": "/book",
      "has": [{ "type": "query", "key": "lang", "value": "zh" }],
      "status": 308,
      "headers": { "Location": "/zh/book" }
    },
    {
      "src": "/about",
      "has": [{ "type": "query", "key": "lang", "value": "zh" }],
      "status": 308,
      "headers": { "Location": "/zh/about" }
    },
    {
      "src": "/collab",
      "has": [{ "type": "query", "key": "lang", "value": "zh" }],
      "status": 308,
      "headers": { "Location": "/zh/collab" }
    },
    {
      "src": "/collab/creators",
      "has": [{ "type": "query", "key": "lang", "value": "zh" }],
      "status": 308,
      "headers": { "Location": "/zh/collab/creators" }
    },
    {
      "src": "/collab/podcast-one-pager\\.pdf",
      "status": 308,
      "headers": { "Location": "/collab/creators" }
    },
    {
      "src": "/podcast-feed\\.xml",
      "dest": "https://feeds.transistor.fm/kedaibiao",
      "headers": {
        "x-vercel-enable-rewrite-caching": "1",
        "CDN-Cache-Control": "public, s-maxage=300, stale-while-revalidate=86400"
      }
    },
    { "handle": "filesystem" }
  ]
}
